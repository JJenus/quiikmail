# ── Server ──────────────────────────────────────────────────────────────
# Hosted Postgres connection string (Neon / Supabase / any postgres)
NUXT_MAIL_DATABASE_URL=postgresql://user:password@host:5432/quiikmail

# Secret used to AES-256-GCM encrypt Resend API keys + webhook secrets at rest.
# Generate with: openssl rand -hex 32
NUXT_MAIL_ENC_KEY=

# Public URL of the app (used to build the Resend webhook URL during setup).
# For local dev with tunnels: https://your-tunnel-domain
NUXT_MAIL_APP_URL=http://localhost:3000

# ── Auth sessions (nuxt-auth-utils) ─────────────────────────────────────
# Signed-cookie session encryption password. Generate with: openssl rand -base64 32
NUXT_SESSION_PASSWORD=
